#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:104
msgid "Integer"
msgstr "Intero"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:87
msgid ""
"Adjust the rotation along the Z- (yaw), X- (pitch) and Y-axis (roll) to "
"compensate for any alignment differences"
msgstr ""
"Regola la rotazione lungo gli assi Z (imbardata), X (beccheggio) e X "
"(rollio) per compensare le differenze di allineamento"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:88
msgid "Lens FOV"
msgstr "CDV della lente"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:90
msgid "Field of View of a single hemisphere in degrees"
msgstr "Campo di vista del singolo emisfero in gradi"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:91
msgid "Lens Radius"
msgstr "Raggio della lente"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:92
#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:95
