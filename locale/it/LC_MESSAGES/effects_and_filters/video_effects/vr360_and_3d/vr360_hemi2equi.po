#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:78
msgid ""
"The fisheye projection type. Currently only equidistant fisheyes, like the "
"Ricoh Theta and Garmin Virb360 are supported."
msgstr ""
"Il tipo di proiezione a occhio di pesce. Attualmente sono supportati solo "
"quelli equidistanti, come Ricoh Theta e Garmin Virb360."

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:79
msgid "Use sensor response parameters"
msgstr "Utilizza i parametri di risposta del sensore"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:80
msgid "Switch"
msgstr "Interruttore"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:81
msgid ""
"Switch on to use sensor response parameters (see EMoR h(x) parameters below)"
msgstr ""
"Attiva per utilizzare i parametri di risposta del sensore (vedi i parametri "
"EMoR h(x) riportati di seguito)"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:82
msgid "Interpolation"
msgstr "Interpolazione"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:84
msgid "Determines the sampling method"
msgstr "Determina il metodo di campionamento"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:85
msgid "Alignment Yaw / Pitch / Roll"
msgstr "Allineamento: Imbardata / Beccheggio / Rollio"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:86
#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:89
