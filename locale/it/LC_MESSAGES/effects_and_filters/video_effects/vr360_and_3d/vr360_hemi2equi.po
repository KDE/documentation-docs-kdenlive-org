#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:116
#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:119
#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:122
msgid "Float"
msgstr "Virgola mobile"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:93
msgid ""
"Radius of the image circle as a fraction of the frame width (for example "
"0.25 = 25% of 1920)"
msgstr ""
"Il raggio del cerchio dell'immagine, come frazione della larghezza del "
"fotogramma (ad esempio 0.25 = 25% di 1920)"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:94
msgid "Front X / Y"
msgstr "Fronte X / Y"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:96
msgid ""
"Defines the center of the image of the front-facing camera. X is expressed "
"as a fraction of the image width, Y as a fraction of the image height."
msgstr ""
"Definisce il centro dell'immagine della videocamera frontale. X è espresso "
"come frazione della larghezza dell'immagine, Y come frazione dell'altezza "
"dell'immagine."

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:97
msgid "Front UP"
msgstr "Fronte SU"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:99
#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:105
msgid ""
"Defines the \"up\" direction in the image in degrees counting clockwise from "
"a directions towards the top edge"
msgstr ""
"Definisce la direzione «verso l'alto» nell'immagine in gradi, contando in "
"senso orario a partire da una direzione verso il bordo superiore"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:100
msgid "Back X / Y"
msgstr "Dietro X / Y"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:102
msgid ""
"Defines the center of the image of the back-facing camera. X is expressed as "
"a fraction of the image width, Y as a fraction of the image height."
msgstr ""
"Definisce il centro dell'immagine della videocamera posteriore. X è espresso "
"come frazione della larghezza dell'immagine, Y come frazione dell'altezza "
"dell'immagine."

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:103
msgid "Back UP"
msgstr "Dietro SU"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:106
msgid "Nadir Radius / Start"
msgstr "Raggio / Inizio nadir"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:108
msgid ""
"Adjust the :abbr:`nadir (direction pointing directly below a particular "
"location)` of the camera if you have parts of the camera or equipment in the "
"image"
msgstr ""
"Regola il :abbr:`nadir (la direzione che punta direttamente al di sotto di "
"un determinato punto)`  della videocamera se nell'immagine sono visibili "
"parti della videocamera o dell'attrezzatura"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:109
msgid "Lens distortion A / B / C"
msgstr "Distorsione della lente A / B / C"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:111
msgid ""
"Lens distortion correction parameters. The first three parameters are the "
"same as in |hugin|."
msgstr ""
"Parametri di correzione della distorsione della lente. I primi tre parametri "
"sono gli stessi di |hugin|."

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:112
msgid "Lens distortion radius"
msgstr "Raggio distorsione della lente"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:114
msgid ""
"Lens distortion correction parameters. If you use |hugin| parameters, the "
"Radius should be set to the value of (0.5 * min(image width, image height) / "
"image width). For a 2:1 aspect dual hemispherical image, that would be 0.25."
msgstr ""
"Parametri per la correzione della distorsione della lente. Se si utilizzano "
"i parametri di |hugin|, il raggio deve essere impostato sul valore (0,5 * "
"min(larghezza immagine, altezza immagine) / larghezza immagine). Per "
"un'immagine emisferica doppia con rapporto 2:1, il valore sarebbe 0,25."

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:115
msgid "Lens vignetting A / B / C / D"
msgstr "Vignettatura della lente A / B / C / D"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:117
msgid ""
"Lens vignetting correction parameters. The first four parameters are the "
"same as in |hugin|, corresponding to the V\\ :sub:`a` , V\\ :sub:`b` , V\\ :"
"sub:`c` , and V\\ :sub:`d` image parameters."
msgstr ""
"Parametri per la correzione della vignettatura della lente. I primi quattro "
"parametri sono gli stessi di |hugin|, e corrispondono ai parametri "
"dell'immagine V\\ :sub:`a` , V\\ :sub:`b` , V\\ :sub:`c` , e V\\ :sub:`d`."

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:118
msgid "Lens vignetting radius"
msgstr "Raggio vignettatura della lente"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:120
msgid ""
"If you use Hugin parameters, the radius should be set to the value of (0.5 * "
"image diagonal / image width). For a 2:1 aspect dual hemispherical image, "
"that would be 0.5590. Use the :kbd:`A` parameter to scale the effect and "
"avoid overexposing highlights."
msgstr ""
"Se si utilizzano i parametri Hugin, il raggio deve essere impostato sul "
"valore (0,5 * diagonale dell'immagine / larghezza dell'immagine) Per "
"un'immagine emisferica doppia con rapporto 2:1, il valore sarebbe 0,5590. "
"Utilizza il parametro :kbd:`A` per ridimensionare l'effetto ed evitare la "
"sovraesposizione delle luci."

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:121
msgid "EMoR h(1 / 2 / 3 / 4 / 5)"
msgstr "EMoR h(1 / 2 / 3 / 4 / 5)"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_hemi2equi.rst:123
msgid ""
"Sensor response parameters. The EMoR h(x) parameters are the same as |"
"hugin|'s R\\ :sub:`a` - R\\ :sub:`e` in the lens parameters. If you use |"
"hugin|-derived values for vignetting correction, you should also use these "
"parameters, as |hugin|'s vignetting correction assumes that the sensor "
"response has been corrected."
msgstr ""
"Parametri di risposta del sensore. I parametri EMoR h(x) corrispondono ai "
"parametri R\\ :sub:`a` - R\\ :sub:`e` di |hugin| relativi alle lenti. Se per "
"la correzione della vignettatura utilizzi i valori derivati da |hugin|, "
"dovresti utilizzare anche questi parametri, poiché la correzione della "
"vignettatura di |hugin| presuppone che la risposta del sensore sia stata "
"corretta."

