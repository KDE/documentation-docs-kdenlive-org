#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_strobing.rst:63
msgid "Interval"
msgstr "Intervallo"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_strobing.rst:64
msgid "Integer"
msgstr "Intero"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_strobing.rst:65
msgid ""
"Defines the strobing interval. Higher numbers mean less frequent strobing."
msgstr ""
"Definisce l'intervallo di stroboscopia: un numero più alto implica una "
"stroboscopia meno frequente."

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_strobing.rst:69
msgid "Notes"
msgstr "Note"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_strobing.rst:70
msgid ""
"An :guilabel:`Interval` of 1 alternates the alpha channel every frame; a "
"value of 100 alternates every 50 frames"
msgstr ""
"Un :guilabel:`Intervallo` di 1 alterna il canale alfa ogni fotogramma, "
"mentre con 100 verrà alternato ogni 50."

