#: ../../compositing/compositions/blend_modes.rst:-1
msgid "Kdenlive Documentation - Compositing: Composition Blend Modes"
msgstr ""
"Documentazione di Kdenlive - compositing: modalità di fusione della "
"composizione"

#: ../../compositing/compositions/blend_modes.rst:-1
msgid ""
"KDE, Kdenlive, documentation, user manual, video editor, open source, free, "
"learn, easy, compositing, composition, compositions, blend, modes"
msgstr ""
"KDE, Kdenlive, documentazione, manuale utente, editor video, open source, "
"libero, impara, facile, compositing, tipo di composizione, composizioni, "
"fusione, modalità"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "Addition /"
msgstr "Addizione /"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "addition_alpha"
msgstr "addition_alpha"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "Add"
msgstr "Aggiungi"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] addition or addition_alpha operation of the pixel sources "
"(|frei0r.addition| and |frei0r.addition_alpha|, respectively)"
msgstr ""
"Esegue un'operazione di addizione RGB[A] oppure addition_alpha sui pixel "
"delle sorgenti (rispettivamente |frei0r.addition| e |frei0r.addition_alpha|)."

#: ../../compositing/compositions/blend_modes.rst:0
msgid "Color Burn"
msgstr "Colore brucia"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] dodge operation between the pixel sources\\ [1]_ (|frei0r."
"burn|)"
msgstr ""
"Esegue un'operazione di scherma RGB[A] tra le sorgenti dei pixel\\ [1]_ (|"
"frei0r.burn|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "No equivalent"
msgstr "Nessun equivalente"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform a conversion to color only of the source input 1 using the hue and "
"saturation values of input 2 (|frei0r.color_only|)"
msgstr ""
"Esegue una conversione per colorare solo la sorgente nell'ingresso  1, "
"utilizzando i valori di tonalità e di saturazione dell'ingresso 2 (|frei0r."
"color_only|)"

#: ../../compositing/compositions/blend_modes.rst:0
#: ../../compositing/compositions/blend_modes.rst:64
msgid "Darken"
msgstr "Più scuro"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform a darken operation between two sources (minimum value for both "
"sources) (|frei0r.darken|)"
msgstr ""
"Esegue un'operazione di inscurimento tra due sorgenti (il valore minimo per "
"entrambe (|frei0r.darken|)"

#: ../../compositing/compositions/blend_modes.rst:0
#: ../../compositing/compositions/blend_modes.rst:70
msgid "Difference"
msgstr "Differenza"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] difference operation between the pixel sources. (|frei0r."
"difference|)"
msgstr ""
"Esegue un'operazione di differenza RGB[A] tre le sorgenti dei pixel. (|"
"frei0r.difference|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] divide operation between the pixel sources\\ [2]_ (|frei0r."
"divide|)"
msgstr ""
"Esegue un'operazione di divisione RGB[A] tre le sorgenti dei pixel\\ [2]_ (|"
"frei0r.divide|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "Color Dodge"
msgstr "Colore scherma"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] dodge operation between the pixel sources\\ [3]_ (|frei0r."
"dodge|)"
msgstr ""
"Esegue un'operazione di scherma RGB[A] tra le sorgenti dei pixel\\ [3]_ (|"
"frei0r.dodge|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] grain-extract operation between the pixel sources (|frei0r."
"grain_extract|)"
msgstr ""
"Esegue un'operazione di estrazione di grana RGB[A] tre le sorgenti dei pixel "
"(|frei0r.grain_extract|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] grain-merge operation between the pixel sources (|frei0r."
"grain_merge|)"
msgstr ""
"Esegue un'operazione di fusione di grana RGB[A] tre le sorgenti dei pixe (|"
"frei0r.grain_mergel|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "Hard light"
msgstr "Luce intensa"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] hardlight operation between the pixel sources (|frei0r."
"hardlight|)"
msgstr ""
"Esegue un'operazione di luce intensa RGB[A] tre le sorgenti dei pixel (|"
"frei0r.hardlight|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "HSL hue"
msgstr "Tonalità HSL"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform a conversion to hue only of the source input1 using the hue of "
"input2 (|frei0r.hue|)"
msgstr ""
"Esegue una conversione di tonalità solo dell'ingresso sorgente1 utilizzando "
"la tonalità della sorgente2 (|frei0r.hue|)"

#: ../../compositing/compositions/blend_modes.rst:0
#: ../../compositing/compositions/blend_modes.rst:112
msgid "Lighten"
msgstr "Più chiaro"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform a lighten operation between two sources (maximum value of both "
"sources) (|frei0r.lighten|)"
msgstr ""
"Esegue un'operazione di schiarimento tra due sorgenti (il valore massimo di "
"entrambe) (|frei0r.lighten|)"

#: ../../compositing/compositions/blend_modes.rst:0
#: ../../compositing/compositions/blend_modes.rst:118
msgid "Multiply"
msgstr "Moltiplica"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] multiply operation between the pixel sources (|frei0r."
"multiply|)"
msgstr ""
"Esegue un'operazione di moltiplicazione RGB[A] tre le sorgenti dei pixel (|"
"frei0r.multiply|)"

#: ../../compositing/compositions/blend_modes.rst:0
#: ../../compositing/compositions/blend_modes.rst:124
msgid "Overlay"
msgstr "Sovrapponi"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] overlay operation between the pixel sources\\ [4]_ (|"
"frei0r.overlay|)"
msgstr ""
"Esegue un'operazione di sovrapposizione RGB[A] tre le sorgenti dei pixel\\ "
"[4]_ (|frei0r.overlay|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "HSL saturation"
msgstr "Saturazione HSL"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform a conversion to saturation only of the source input1 using the "
"saturation level of input2 (|frei0r.saturation|)"
msgstr ""
"Esegue una conversione della saturazione solamente per la sorgente "
"nell'ingresso 1, utilizzando il livello di saturazione dell'ingresso 2 (|"
"frei0r.saturation|)"

#: ../../compositing/compositions/blend_modes.rst:0
#: ../../compositing/compositions/blend_modes.rst:136
msgid "Screen"
msgstr "Scolora (Screen)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] screen operation between the pixel sources\\ [5]_ "
"effectively using black as the alpha channel (|frei0r.screen|)"
msgstr ""
"Esegue un'operazione di schermo RGB[A] tre le sorgenti dei pixel\\ [5]_ "
"utilizzando efficacemente il nero come canale alfa (|frei0r.screen|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "Soft light"
msgstr "Luce soffusa"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] softlight operation between the pixel sources (|frei0r."
"softlight|)"
msgstr ""
"Esegue un'operazione di luce soffusa RGB[A] tre le sorgenti dei pixel (|"
"frei0r.softlight|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] subtract operation of the pixel source input2 from input1 "
"(|frei0r.subtract|)"
msgstr ""
"Esegue un'operazione di sottrazione RGB[A] della sorgenti di pixel ingresso "
"2 da ingresso 1(|frei0r.subtract|)"

#: ../../compositing/compositions/blend_modes.rst:15
msgid "Composition Blend Modes"
msgstr "Modalità di fusione della composizione"

#: ../../compositing/compositions/blend_modes.rst:17
msgid ""
"For Kdenlive, some composition types are basically :doc:`blending modes </"
"compositing/blending_modes>` (see there for a detailed description)."
msgstr ""
"In Kdenlive, alcuni tipi di composizione sono essenzialmente dei :doc:"
"`metodi di fusione </compositing/blending_modes>` (per una descrizione "
"dettagliata, vedi la relativa sezione)."

#: ../../compositing/compositions/blend_modes.rst:26
msgid "Changing the composition **Blend Mode**"
msgstr "Modifica della **modalità di fusione** della composizione"

#: ../../compositing/compositions/blend_modes.rst:28
msgid ""
"You can change the **Blend Mode** by selecting from the :guilabel:"
"`Composition Type` drop-down list."
msgstr ""
"Puoi modificare la **Modalità di fusione** selezionandola dall'elenco a "
"tendina :guilabel:`Tipo di composizione`."

#: ../../compositing/compositions/blend_modes.rst:32
msgid ""
"The following table below lists the composition types and their blending "
"mode counterpart in :guilabel:`Composition Type` **Cairo Blend**:"
msgstr ""
"La tabella seguente elenca i tipi di composizione e la relativa modalità di "
"fusione per il :guilabel:`Tipo di composizione` **Fusione Cairo**:"

