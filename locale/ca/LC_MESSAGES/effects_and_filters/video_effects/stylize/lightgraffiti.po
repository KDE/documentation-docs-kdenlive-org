#: ../../effects_and_filters/video_effects/stylize/lightgraffiti.rst:113
msgid "Brightness threshold"
msgstr "Llindar de la lluminositat"

#: ../../effects_and_filters/video_effects/stylize/lightgraffiti.rst:114
#: ../../effects_and_filters/video_effects/stylize/lightgraffiti.rst:117
#: ../../effects_and_filters/video_effects/stylize/lightgraffiti.rst:120
