msgstr "Largura do contorno"

#: ../../effects_and_filters/video_effects/generate/gps_text.rst:82
msgid "Set the width of the outline in pixels to 0, 1, 2 or 3"
msgstr "Define a largura do contorno em pixels para 0, 1, 2 ou 3"

#: ../../effects_and_filters/video_effects/generate/gps_text.rst:83
msgid "Underline"
msgstr "Sublinhado"

