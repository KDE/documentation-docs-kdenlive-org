msgid "Kdenlive Documentation - File Management - Archiving"
msgstr "Dokumentácia Kdenlive - Správa súborov - Archivovanie"

#: ../../project_and_asset_management/file_management/archiving.rst:-1
msgid ""
"KDE, Kdenlive, project bin, working, file, management, archive, archiving, "
"documentation, user manual, video editor, open source, free, learn, easy"
msgstr ""
"KDE, Kdenlive, zásobník projektu, práca, súbor, správa, archív, "
"archivovanie, dokumentácia, používateľská príručka, editor videa, open "
