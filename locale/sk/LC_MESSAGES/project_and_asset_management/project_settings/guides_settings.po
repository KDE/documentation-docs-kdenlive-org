#: ../../project_and_asset_management/project_settings/guides_settings.rst:22
msgid "Markers Settings"
msgstr "Nastavenia sprievodcov"

#: ../../project_and_asset_management/project_settings/guides_settings.rst:24
msgid ""
"In this tab you define project-specific categories and colors for markers "
"and timeline markers."
msgstr ""
"Na tejto karte definujete kategórie a farby špecifické pre projekt pre "
"značky a značky časovej osi."

#: ../../project_and_asset_management/project_settings/guides_settings.rst:33
msgid "The Project Settings Markers dialog window"
msgstr "Dialógové okno nastavení značiek projektu"

#: ../../project_and_asset_management/project_settings/guides_settings.rst:35
msgid ":guilabel:`Add category`: Adds a category"
msgstr ":guilabel:`Pridať kategóriu`: Pridá kategóriu"

#: ../../project_and_asset_management/project_settings/guides_settings.rst:37
msgid ":guilabel:`Edit category`: Edits the currently selected category"
msgstr ":guilabel:`Upraviť kategóriu`: Upraví aktuálne vybranú kategóriu"

#: ../../project_and_asset_management/project_settings/guides_settings.rst:39
msgid ":guilabel:`Delete category`: Deletes the currently selected category"
msgstr ":guilabel:`Odstrániť kategóriu`: Odstráni aktuálne vybranú kategóriu"

#: ../../project_and_asset_management/project_settings/guides_settings.rst:48
msgid "The category add/edit dialog window"
msgstr "Dialógové okno pridania/úpravy kategórie"

#: ../../project_and_asset_management/project_settings/guides_settings.rst:50
msgid "Click on the color button to select a color for the category."
msgstr "Kliknite na tlačidlo farby a vyberte farbu pre kategóriu."

#: ../../project_and_asset_management/project_settings/guides_settings.rst:52
msgid "Enter a name for the category."
msgstr "Zadajte názov kategórie."
