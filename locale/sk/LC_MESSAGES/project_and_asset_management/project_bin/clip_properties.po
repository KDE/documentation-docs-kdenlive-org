#: ../../project_and_asset_management/project_bin/clip_properties.rst:83
msgid ":guilabel:`Field order`:"
msgstr ":guilabel:`Field order`:"

#: ../../project_and_asset_management/project_bin/clip_properties.rst:83
msgid "The current field order (only applicable to *interlaced* scanning)"
msgstr "Aktuálne poradie polí (platí iba pre *prekladané* skenovanie)"

#: ../../project_and_asset_management/project_bin/clip_properties.rst:86
msgid ":guilabel:`Disable auto-rotate`:"
msgstr ":guilabel:`Disable auto-rotate`:"

#: ../../project_and_asset_management/project_bin/clip_properties.rst:86
msgid ""
"If checked will prevent the image to be rotated according to its embedded "
"rotation setting (not present in all images)"
msgstr ""
"Ak je zaškrtnuté, zabráni otočeniu obrázka podľa jeho vloženého nastavenia "
"rotácie (nie je prítomné vo všetkých obrázkoch)"

#: ../../project_and_asset_management/project_bin/clip_properties.rst:89
msgid ":guilabel:`Color space`:"
msgstr ":guilabel:`Color space`:"

#: ../../project_and_asset_management/project_bin/clip_properties.rst:89
msgid "The current :term:`color space` of the clip"
msgstr "Aktuálny :term:`color space` klipu"

#: ../../project_and_asset_management/project_bin/clip_properties.rst:92
msgid ""
"The current :term:`color range` of the clip. This is mostly relevant for "
"videos intended for broadcasting."
msgstr ""
"Aktuálny :term:`color range` klipu. Je to relevantné predovšetkým pre videá "
"určené na vysielanie."

#: ../../project_and_asset_management/project_bin/clip_properties.rst:93
msgid ":guilabel:`Color range`:"
msgstr ":guilabel:`Color range`:"

#: ../../project_and_asset_management/project_bin/clip_properties.rst:98
