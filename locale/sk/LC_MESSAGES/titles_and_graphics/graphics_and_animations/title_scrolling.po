#: ../../titles_and_graphics/graphics_and_animations/title_scrolling.rst:0
msgid "Start viewport above end viewport"
msgstr "Počiatočný výrez pohľadu je nad koncovým výrezom pohľadu"

#: ../../titles_and_graphics/graphics_and_animations/title_scrolling.rst:0
msgid "Start viewport below end viewport"
msgstr "Počiatočný výrez pohľadu je pod koncovým výrezom pohľadu"

#: ../../titles_and_graphics/graphics_and_animations/title_scrolling.rst:0
msgid "Start viewport left of end viewport"
msgstr "Počiatočný výrez pohľadu je naľavo od koncového výrezu pohľadu"

