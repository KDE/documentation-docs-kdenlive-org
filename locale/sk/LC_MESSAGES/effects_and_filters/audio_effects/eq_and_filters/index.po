#: ../../effects_and_filters/audio_effects/eq_and_filters/index.rst:24
msgid "EQ and Filters"
msgstr "EQ a filtre"

#: ../../effects_and_filters/audio_effects/eq_and_filters/index.rst:26
msgid ""
"This category consists of effects and filters for things like high and low "
"pass, audio equalizer, and band pass."
msgstr ""
"Táto kategória pozostáva z efektov a filtrov pre veci ako vysokofrekvenčný a "
"nízkofrekvenčný priepust, zvukový ekvalizér a pásmový priepust."

#: ../../effects_and_filters/audio_effects/eq_and_filters/index.rst:46
msgid ""
"The following filters and effects are available but not documented here. "
"Please refer to the |avfilter| documentation for more details."
msgstr ""
"Nasledujúce filtre a efekty sú dostupné, ale nie sú tu zdokumentované. "
"Ďalšie podrobnosti nájdete v dokumentácii |avfilter|."

