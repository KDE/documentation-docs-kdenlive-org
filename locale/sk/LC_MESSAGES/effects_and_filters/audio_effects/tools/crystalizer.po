#: ../../effects_and_filters/audio_effects/tools/crystalizer.rst:58
msgid "Float"
msgstr "Reálne číslo"

#: ../../effects_and_filters/audio_effects/tools/crystalizer.rst:59
msgid ""
"Sets the intensity of effect. Range is -10.0 to 0 (unchanged sound) to 10.0 "
"(maximum effect);  default is 2.0. To inverse filtering use negative values."
msgstr ""
"Nastaví intenzitu efektu. Rozsah je od -10.0 do 0 (nezmenený zvuk) do 10.0 "
"(maximálny efekt); predvolená je 2.0. Pre inverzné filtrovanie použite "
"záporné hodnoty."

#: ../../effects_and_filters/audio_effects/tools/crystalizer.rst:60
msgid "**Enable Clipping**"
msgstr "**Povoliť orezanie**"

#: ../../effects_and_filters/audio_effects/tools/crystalizer.rst:61
msgid "Switch"
msgstr "Prepnúť"

#: ../../effects_and_filters/audio_effects/tools/crystalizer.rst:62
