#: ../../effects_and_filters/audio_effects/tools/crystalizer.rst:42
msgid ""
"This effect performs simple audio noise sharpening by linearly increasing "
"differences between each audio sample."
msgstr ""
"Tento efekt vykonáva jednoduché ostrenie zvukového šumu lineárnym zvyšovaním "
"rozdielov medzi jednotlivými zvukovými vzorkami."

