#: ../../effects_and_filters/audio_effects/tools/index.rst:-1
msgid "Kdenlive Audio Effects - Tools"
msgstr "Zvukové efekty Kdenlive - Nástroje"

#: ../../effects_and_filters/audio_effects/tools/index.rst:-1
msgid ""
"KDE, Kdenlive, documentation, user manual, video editor, open source, audio "
"effects, tools"
msgstr ""
"KDE, Kdenlive, dokumentácia, používateľská príručka, editor videa, open "
"source, zvukové efekty, nástroje"

#: ../../effects_and_filters/audio_effects/tools/index.rst:24
msgid "Tools"
msgstr "Nástroje"

#: ../../effects_and_filters/audio_effects/tools/index.rst:26
msgid ""
"This category consists of computational tools. These are more geared towards "
"further processing of the audio streams."
msgstr ""
"Táto kategória obsahuje výpočtové nástroje. Tieto sú viac zamerané na ďalšie "
"spracovanie zvukových prúdov."

#: ../../effects_and_filters/audio_effects/tools/index.rst:28
msgid "The following filters and effects are available:"
msgstr "K dispozícii sú nasledujúce filtre a efekty:"

#: ../../effects_and_filters/audio_effects/tools/index.rst:37
msgid ""
"The following filters are more geared towards further processing of the "
"audio streams with potential extra hardware required, and are not documented "
"here. Please refer to the |ffmpeg_filter| documentation (section *8 Audio "
"Filter*)."
msgstr ""
"Nasledujúce filtre sú viac zamerané na ďalšie spracovanie zvukových prúdov s "
"možným požadovaným dodatočným hardvérom a nie sú tu zdokumentované. Pozrite "
"si dokumentáciu |ffmpeg_filter| (časť *8 Audio Filter*)."

#: ../../effects_and_filters/audio_effects/tools/index.rst:39
msgid "Aderivative"
msgstr "Aderivative"

#: ../../effects_and_filters/audio_effects/tools/index.rst:40
msgid "Aintegral"
msgstr "Aintegral"
