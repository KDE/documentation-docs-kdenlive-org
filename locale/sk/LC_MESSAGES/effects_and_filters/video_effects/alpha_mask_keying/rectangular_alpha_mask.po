msgstr "Parameter"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:65
msgid "Value"
msgstr "Hodnota"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:67
msgid "Invert"
msgstr "Prevrátiť"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:68
msgid "Switch"
msgstr "Prepnúť"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:69
msgid "Invert the selection"
msgstr "Prevrátiť výber"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:70
msgid "Left"
msgstr "Vľavo"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:71
#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:74
#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:77
#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:80
#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:83
msgid "Integer"
msgstr "Celé číslo"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:72
msgid ""
"Defines the left edge of the rectangular in number of pixels from the left "
"of the frame"
msgstr "Definuje ľavý okraj obdĺžnika v počte pixelov od ľavého okraja snímky"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:73
msgid "Right"
msgstr "Vpravo"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:75
msgid ""
"Defines the right edge of the rectangular in number of pixels from the right "
"of the frame"
msgstr ""
"Definuje pravý okraj obdĺžnika v počte pixelov od pravého okraja snímky"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:76
msgid "Top"
msgstr "Hore"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:78
msgid ""
"Defines the top edge of the rectangular in number of pixels from the top of "
"the frame"
msgstr ""
"Definuje horný okraj obdĺžnika v počte pixelov od horného okraja snímky"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:79
msgid "Bottom"
msgstr "Dole"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:81
msgid ""
"Defines the bottom edge of the rectangular in number of pixels from the "
"bottom of the frame"
msgstr ""
"Definuje dolný okraj obdĺžnika v počte pixelov od dolného okraja snímky"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:82
msgid "Blur"
msgstr "Rozmazať"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/rectangular_alpha_mask.rst:84
msgid ""
"Defines the number of pixels around the edge of the rectangular where :abbr:"
"`feathering (Smoothing or blurring the edges of a feature)` takes place. "
"Default is 0 (hard edge)."
msgstr ""
"Definuje počet pixelov okolo okraja obdĺžnika, kde prebieha :abbr:"
"`rozpíjanie (Vyhladzovanie alebo rozmazávanie okrajov prvku)`. Predvolená "
"hodnota je 0 (tvrdý okraj)."

