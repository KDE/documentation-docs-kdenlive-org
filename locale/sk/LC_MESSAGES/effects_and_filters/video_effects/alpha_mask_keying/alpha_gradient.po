"Position where the gradient starts (default is half the project vertical "
"resolution)"
msgstr ""
"Poloha, kde prechod začína (predvolená hodnota je polovica zvislého "
"rozlíšenia projektu)"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:65
msgid "Transition width"
msgstr "Šírka prechodu"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:66
#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:72
#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:75
msgid "Percentage"
msgstr "Percento"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:67
msgid "Width of the gradient (default is 505)"
msgstr "Šírka prechodu (predvolená hodnota je 505)"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:68
msgid "Tilt"
msgstr "Sklon"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:69
msgid "Degrees"
msgstr "Stupňe"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:70
msgid "Rotation of the gradient in degrees (range is 0-360, default is 0)"
msgstr ""
"Otočenie prechodu v stupňoch (rozsah je 0–360, predvolená hodnota je 0)"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:71
msgid "Transparency top"
msgstr "Priehľadnosť navrchu"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:73
msgid ""
"Sets the transparency at the top / start of the gradient (default is 100% "
"for full transparency)"
msgstr ""
"Nastavuje priehľadnosť v hornej časti / na začiatku prechodu (predvolená "
"hodnota je 100 % pre úplnú priehľadnosť)"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:74
msgid "Transparency bottom"
msgstr "Priehľadnosť dole"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:76
msgid ""
"Sets the transparency at the bottom / end of the gradient (default is 0% for "
"no transparency)"
msgstr ""
"Nastavuje priehľadnosť v dolnej časti / na konci prechodu (predvolená "
"hodnota je 0 % pre žiadnu priehľadnosť)"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:78
