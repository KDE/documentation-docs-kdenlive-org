msgid "Write on clear"
msgstr "Zapisovať na čistý"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:88
msgid "Overlay the image (default)"
msgstr "Prekryť obrázok (predvolené)"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:89
msgid "Add"
msgstr "Pridať"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_gradient.rst:90
msgid "Add the existing pixel and the calculated gradient values"
msgstr "Sčítať existujúcu hodnotu pixelu a vypočítané hodnoty prechodu"

