msgstr "Výber"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_equi2rect.rst:59
msgid "Choose the interpolation algorithm"
msgstr "Vyberte interpolačný algoritmus"

#: ../../effects_and_filters/video_effects/vr360_and_3d/vr360_equi2rect.rst:60
