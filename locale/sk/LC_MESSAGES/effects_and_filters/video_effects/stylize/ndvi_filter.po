#: ../../effects_and_filters/video_effects/stylize/ndvi_filter.rst:65
msgid "VIS Scale"
msgstr "Mierka"

#: ../../effects_and_filters/video_effects/stylize/ndvi_filter.rst:67
msgid "A scaling factor to be applied to the visible component (divided by 10)"
msgstr ""
"Faktor škálovania, ktorý sa má aplikovať na viditeľnú zložku (delené 10)"

#: ../../effects_and_filters/video_effects/stylize/ndvi_filter.rst:68
msgid "VIS Offset"
msgstr "Posun"

#: ../../effects_and_filters/video_effects/stylize/ndvi_filter.rst:70
msgid ""
"An offset to be applied to the visible component (mapped to [-100%, 100%])"
msgstr ""
"Posun, ktorý sa má aplikovať na viditeľnú zložku (mapované na [-100 %, 100 "
"%])"

#: ../../effects_and_filters/video_effects/stylize/ndvi_filter.rst:71
msgid "NIR Scale"
msgstr "Mierka"

#: ../../effects_and_filters/video_effects/stylize/ndvi_filter.rst:73
msgid ""
"A scaling factor to be applied to the near-infrared component (divided by 10)"
msgstr ""
"Faktor škálovania, ktorý sa má aplikovať na blízku infračervenú zložku "
"(delené 10)"

#: ../../effects_and_filters/video_effects/stylize/ndvi_filter.rst:74
msgid "NIR Offset"
msgstr "Posun"

#: ../../effects_and_filters/video_effects/stylize/ndvi_filter.rst:76
msgid ""
"An offset to be applied to the near-infrared component (mapped to [-100%, "
"100%])"
msgstr ""
"Posun, ktorý sa má aplikovať na blízku infračervenú zložku (mapované na "
"[-100 %, 100 %])"

