#: ../../effects_and_filters/video_effects/transform_distort_perspective.rst:24
msgid "Transform, Distort and Perspective"
msgstr "Transformácia, deformácia a perspektíva"

#: ../../effects_and_filters/video_effects/transform_distort_perspective.rst:26
msgid ""
"The *Transform, Distort and Perspective* video effects category provides "
"effects and filters for manipulating the shape, size and position of the "
"source clip(s), such as :doc:`/effects_and_filters/video_effects/"
"transform_distort_perspective/transform` and :doc:`/effects_and_filters/"
"video_effects/transform_distort_perspective/crop_scale_tilt` effects."
msgstr ""
"Kategória video efektov *Transformácia, deformácia a perspektíva* poskytuje "
"efekty a filtre na manipuláciu s tvarom, veľkosťou a pozíciou zdrojového "
"klipu (klipov), ako napríklad efekty :doc:`/effects_and_filters/"
"video_effects/transform_distort_perspective/transform` a :doc:`/"
"effects_and_filters/video_effects/transform_distort_perspective/"
"crop_scale_tilt`."

