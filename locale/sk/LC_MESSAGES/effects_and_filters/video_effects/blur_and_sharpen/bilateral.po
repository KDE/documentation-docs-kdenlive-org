#: ../../effects_and_filters/video_effects/blur_and_sharpen/bilateral.rst:65
msgid ""
"Set sigma of Gaussian function to calculate spatial weight. Range is 0.000 "
"to 512.000, default is 0.100"
msgstr ""
"Nastaví sigmu Gaussovej funkcie na výpočet priestorovej váhy. Rozsah je "
"0.000 až 512.000, predvolená je 0.100."

#: ../../effects_and_filters/video_effects/blur_and_sharpen/bilateral.rst:66
msgid "Range sigma"
msgstr "Sigma rozsahu"

#: ../../effects_and_filters/video_effects/blur_and_sharpen/bilateral.rst:68
msgid ""
"Set sigma of Gaussian function to calculate range weight. Range is 0.000 to "
"1.000, default is 0.100"
msgstr ""
"Nastaví sigmu Gaussovej funkcie na výpočet váhy rozsahu. Rozsah je 0.000 až "
"1.000, predvolená je 0.100."

