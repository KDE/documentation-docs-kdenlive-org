#: ../../effects_and_filters/video_effects/blur_and_sharpen/gaussian_blur.rst:66
msgid ""
"Set horizontal sigma, standard deviation of Gaussian blur. Determines the "
"strength of the horizontal blur. Default is 10."
msgstr ""
"Nastavuje horizontálnu sigmu, štandardnú odchýlku gaussovského rozmazania. "
"Určuje silu horizontálneho rozmazania. Predvolená hodnota je 10."

#: ../../effects_and_filters/video_effects/blur_and_sharpen/gaussian_blur.rst:67
msgid "Vertical Sigma"
msgstr "Vertikálna sigma"

#: ../../effects_and_filters/video_effects/blur_and_sharpen/gaussian_blur.rst:69
