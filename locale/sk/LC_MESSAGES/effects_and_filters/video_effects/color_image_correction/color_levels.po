#: ../../effects_and_filters/video_effects/color_image_correction/color_levels.rst:61
msgid ""
"Adjust red, green and blue input black point. Allowed values are 0 to 1.0, "
"default is 0."
msgstr ""
"Nastaví vstupný čierny bod červenej, zelenej a modrej. Povolené hodnoty sú "
"od 0 do 1,0, predvolená hodnota je 0."

#: ../../effects_and_filters/video_effects/color_image_correction/color_levels.rst:66
msgid ""
"Adjust red, green and blue input white point. Allowed values are 0 to 1.0, "
"default is 1."
msgstr ""
"Nastaví vstupný biely bod červenej, zelenej a modrej. Povolené hodnoty sú od "
"0 do 1,0, predvolená hodnota je 1."

#: ../../effects_and_filters/video_effects/color_image_correction/color_levels.rst:71
msgid ""
"Adjust red, green and blue output black point. Allowed values are 0 to 1.0, "
"default is 0."
msgstr ""
"Nastaví výstupný čierny bod červenej, zelenej a modrej. Povolené hodnoty sú "
"od 0 do 1,0, predvolená hodnota je 0."

#: ../../effects_and_filters/video_effects/color_image_correction/color_levels.rst:76
msgid ""
"Adjust red, green and blue output white point. Allowed values are 0 to 1.0, "
"default is 1."
msgstr ""
"Nastaví výstupný biely bod červenej, zelenej a modrej. Povolené hodnoty sú "
"od 0 do 1,0, predvolená hodnota je 1."

