msgstr "Výsledok"

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:64
msgid "Add a stop"
msgstr "Pridať zarážku"

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:65
msgid "Left-clicking anywhere on or directly below the gradient bar"
msgstr ""
"Kliknutie ľavým tlačidlom kdekoľvek na lište prechodu alebo priamo pod ňou"

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:66
msgid "Delete a stop"
msgstr "Odstrániť zarážku"

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:67
msgid "Right-click the stop"
msgstr "Kliknutie pravým tlačidlom na zarážku"

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:68
msgid "Move a stop"
msgstr "Presunúť zarážku"

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:69
msgid "Drag the stop to the new position"
msgstr "Potiahnite zarážku na novú polohu"

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:70
msgid "Change the color at the stop"
msgstr "Zmeniť farbu v zarážke"

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:71
msgid ""
"Double-click the stop and select the color from the color selection window"
msgstr "Dvakrát kliknite na zarážku a vyberte farbu v okne výberu farby"

