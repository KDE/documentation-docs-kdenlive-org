#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:44
msgid "Description"
msgstr "Popis"

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:45
msgid "This effect/filter creates a gradient map for the selected clip."
msgstr "Tento efekt/filter vytvorí pre vybraný klip mapu prechodu."

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:47
msgid ""
"By default, the effect has a gradient that goes from black to white turning "
"the clip into a black-and-white image. The effect supports an alpha channel "
"which will be shown as a light/dark checkerboard pattern behind any "
"translucent stop."
msgstr ""
"Predvolene má efekt prechod od čiernej po bielu, čím klip zmení na "
"čiernobiely obraz. Efekt podporuje kanál alfa, ktorý sa zobrazí ako svetlá/"
"tmavá šachovnica za každou priesvitnou zarážkou."

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:51
msgid "Parameters"
msgstr "Parametre"

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:52
msgid "You can define up to 32 gradient stops."
msgstr "Môžete určiť až 32 zarážok prechodu."

#: ../../effects_and_filters/video_effects/color_image_correction/gradientmap.rst:55
msgid "Usage"
