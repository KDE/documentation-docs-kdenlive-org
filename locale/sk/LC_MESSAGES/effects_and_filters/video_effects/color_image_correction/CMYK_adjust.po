"Adjustments for blue pixels (pixels where the blue component is the maximum)"
msgstr "Úpravy pre modré pixely (pixely, kde je modrá zložka maximálna)"

#: ../../effects_and_filters/video_effects/color_image_correction/CMYK_adjust.rst:73
msgid "Magentas"
msgstr "Purpury"

#: ../../effects_and_filters/video_effects/color_image_correction/CMYK_adjust.rst:75
msgid ""
"Adjustments for magenta pixels (pixels where the green component is the "
"minimum)"
msgstr "Úpravy pre purpurové pixely (pixely, kde je zelená zložka minimálna)"

#: ../../effects_and_filters/video_effects/color_image_correction/CMYK_adjust.rst:76
msgid "Whites"
msgstr "Biela"

#: ../../effects_and_filters/video_effects/color_image_correction/CMYK_adjust.rst:78
