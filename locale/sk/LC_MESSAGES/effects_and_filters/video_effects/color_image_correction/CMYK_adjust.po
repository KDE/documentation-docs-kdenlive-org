msgid "Yellows"
msgstr "Žlté"

#: ../../effects_and_filters/video_effects/color_image_correction/CMYK_adjust.rst:63
msgid ""
"Adjustments for yellow pixels (pixels where the blue component is the "
"minimum)"
msgstr "Úpravy pre žlté pixely (pixely, kde je modrá zložka minimálna)"

#: ../../effects_and_filters/video_effects/color_image_correction/CMYK_adjust.rst:64
msgid "Greens"
msgstr "Zelené"

