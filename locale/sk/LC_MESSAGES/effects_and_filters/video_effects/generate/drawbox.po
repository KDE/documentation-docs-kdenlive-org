#: ../../effects_and_filters/video_effects/generate/drawbox.rst:59
msgid "Defines the color for the box"
msgstr "Definuje farbu obdĺžnika"

#: ../../effects_and_filters/video_effects/generate/drawbox.rst:60
msgid "Replace color and alpha"
msgstr "Nahradiť klip"

#: ../../effects_and_filters/video_effects/generate/drawbox.rst:61
msgid "Switch"
msgstr "Prepnúť"

#: ../../effects_and_filters/video_effects/generate/drawbox.rst:62
msgid ""
"If the input has alpha, checking this    will overwrite the video's color "
"and alpha pixels with the pixels of the painted box. By default (off), the "
"box will be composited onto the input, leaving the video's alpha intact."
msgstr ""
"Ak má vstup alfa, zaškrtnutie tohto prepíše farebné a alfa pixely videa "
"pixelmi namaľovaného obdĺžnika. Predvolene (vypnuté) bude obdĺžnik "
"kompozitne vložený do vstupu, pričom alfa videa zostane nedotknutá."

#: ../../effects_and_filters/video_effects/generate/drawbox.rst:63
msgid "Top-left X / Y"
msgstr "X / Y ľavého horného rohu"

#: ../../effects_and_filters/video_effects/generate/drawbox.rst:64
#: ../../effects_and_filters/video_effects/generate/drawbox.rst:67
#: ../../effects_and_filters/video_effects/generate/drawbox.rst:70
#: ../../effects_and_filters/video_effects/generate/drawbox.rst:73
msgid "Integer"
msgstr "Celé číslo"

#: ../../effects_and_filters/video_effects/generate/drawbox.rst:65
msgid ""
"Defines the coordinates for the top left-hand corner of the box (coordinates "
"are based on the project dimension settings)"
msgstr ""
"Definuje súradnice ľavého horného rohu obdĺžnika (súradnice sú založené na "
"nastaveniach rozmerov projektu)"

#: ../../effects_and_filters/video_effects/generate/drawbox.rst:66
msgid "Width (px)"
msgstr "Šírka"

#: ../../effects_and_filters/video_effects/generate/drawbox.rst:68
msgid "Defines the width in pixels"
msgstr "Definuje šírku v pixeloch"

#: ../../effects_and_filters/video_effects/generate/drawbox.rst:69
msgid "Height (px)"
msgstr "Výška"

#: ../../effects_and_filters/video_effects/generate/drawbox.rst:71
msgid "Defines the height in pixels"
msgstr "Definuje výšku v pixeloch"

#: ../../effects_and_filters/video_effects/generate/drawbox.rst:72
msgid "Thickness (px)"
msgstr "Hrúbka čiary"

#: ../../effects_and_filters/video_effects/generate/drawbox.rst:74
msgid ""
"Defines the thickness of the line in pixels. If set high enough, the box is "
"essentially filled."
msgstr ""
"Definuje hrúbku čiary v pixeloch. Ak je nastavená dostatočne vysoko, "
"obdĺžnik sa v podstate vyplní."

