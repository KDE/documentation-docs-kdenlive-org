#: ../../effects_and_filters/video_effects/generate/video_grid.rst:42
msgid ""
"This effect creates a grid of copies of the video footage. You adjust the "
"number of rows and columns in the image with the :guilabel:`Rows` and :"
"guilabel:`Columns` parameters. These take decimal fractions from zero to 1. "
"The maximum value of 1 means 20 rows or columns."
msgstr ""
"Tento efekt vytvorí mriežku kópií video záznamu. Počet riadkov a stĺpcov v "
"obraze nastavíte pomocou parametrov :guilabel:`Riadky` a :guilabel:`Stĺpce`. "
"Tieto prijímajú desatinné zlomky od nuly do 1. Maximálna hodnota 1 znamená "
"20 riadkov alebo stĺpcov."

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:46
msgid "Parameters"
msgstr "Parametre"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:53
msgid "Parameter"
msgstr "Parameter"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:54
msgid "Value"
msgstr "Hodnota"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:56
msgid "Rows"
msgstr "Riadky"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:57
#: ../../effects_and_filters/video_effects/generate/video_grid.rst:60
msgid "Float"
msgstr "Reálne číslo"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:58
msgid ""
"Number of rows in the image grid. Input range 0 - 1 is interpreted as range "
"1 - 20."
msgstr ""
"Počet riadkov v mriežke obrázkov. Vstupný rozsah 0 - 1 je interpretovaný ako "
"rozsah 1 - 20."

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:59
msgid "Columns"
msgstr "Stĺpce"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:61
msgid ""
"Number of columns in the image grid. Input range 0 - 1 is interpreted as "
"range 1 - 20."
msgstr ""
"Počet stĺpcov v mriežke obrázkov. Vstupný rozsah 0 - 1 je interpretovaný ako "
"rozsah 1 - 20."

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:64
msgid ""
"``Number of rows/columns = (p X 19) + 1``    [where p = the value of the row "
"or column parameter]"
msgstr ""
"``Počet riadkov/stĺpcov = (p X 19) + 1``    [kde p = hodnota parametra "
"riadka alebo stĺpca]"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:68
msgid "Examples"
msgstr "Príklady"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:74
msgid "Video Grid effect with 3 rows and 6 columns"
msgstr "Efekt Videomriežka s 3 riadkami a 6 stĺpcami"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:79
msgid "rows = 0.105 ⇒  means (0.1 X 19) + 1 =  3 rows"
msgstr "riadky = 0,105 ⇒ znamená (0,1 X 19) + 1 = 3 riadky"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:81
msgid "columns = 0.263 ⇒ means (0.263 X 19) + 1 = 6  columns"
msgstr "stĺpce = 0,263 ⇒ znamená (0,263 X 19) + 1 = 6 stĺpcov"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:83
msgid ""
"In order to calculate the fractional value for :guilabel:`Rows` and :"
"guilabel:`Columns` for a specific number of rows and/or columns use this "
"formula:"
msgstr ""
"Na výpočet zlomkovej hodnoty pre :guilabel:`Riadky` a :guilabel:`Stĺpce` pre "
"konkrétny počet riadkov a/alebo stĺpcov použite tento vzorec:"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:85
msgid "``Rows/Columns = (#_of_rows/columns - 1) * 0.05263``"
msgstr "``Riadky/Stĺpce = (počet_riadkov/stĺpcov - 1) * 0,05263``"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:88
msgid "#_of_rows = 3 ⇒ means (3 - 1) * 0.05263 = 0.105"
msgstr "počet_riadkov = 3 ⇒ znamená (3 - 1) * 0,05263 = 0,105"

#: ../../effects_and_filters/video_effects/generate/video_grid.rst:90
msgid "#_of_columns = 6 ⇒ means (6 -1) * 0.05263 = 0.263"
msgstr "počet_stĺpcov = 6 ⇒ znamená (6 - 1) * 0,05263 = 0,263"

