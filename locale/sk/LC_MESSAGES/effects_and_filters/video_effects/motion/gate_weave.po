#: ../../effects_and_filters/video_effects/motion/gate_weave.rst:61
msgid "Parameter"
msgstr "Parameter"

#: ../../effects_and_filters/video_effects/motion/gate_weave.rst:62
msgid "Value"
msgstr "Hodnota"

#: ../../effects_and_filters/video_effects/motion/gate_weave.rst:64
