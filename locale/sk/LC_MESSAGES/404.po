#: ../../404.rst:6
msgid "File Not Found (404)"
msgstr "Súbor nenájdený (404)"

#: ../../404.rst:8
msgid "This page does not exist."
msgstr "Táto stránka neexistuje."

#: ../../404.rst:10
msgid "This might be because of the following:"
msgstr "Toto môže byť spôsobené nasledovným:"

#: ../../404.rst:12
msgid ""
"We moved the manual from MediaWiki to Sphinx and with that came a lot of "
"reorganization."
msgstr ""
"Presunuli sme manuál z MediaWiki do Sphinxu a s tým prišlo mnoho "
"reorganizácie."

#: ../../404.rst:13
msgid "The page has been deprecated."
msgstr "Táto stránka je zastaralá."

#: ../../404.rst:14
msgid "Or a simple typo in the URL."
msgstr "Alebo jednoduchý preklep v adrese URL."

#: ../../404.rst:16
msgid ""
"In all cases, you might be able to find the page you're looking for by using "
"the search in the left hand navigation."
msgstr ""
"Vo všetkých prípadoch môžete stránku, ktorú hľadáte, nájsť pomocou "
"vyhľadávania v ľavej navigácii."
