#: ../../user_interface/customizing_interface.rst:-1
msgid "Kdenlive's User Interface - Customizing the Interface"
msgstr "Používateľské rozhranie Kdenlive – prispôsobenie rozhrania"

#: ../../user_interface/customizing_interface.rst:-1
msgid ""
"KDE, Kdenlive, user interface, widget, layout, arrange, documentation, user "
"manual, video editor, open source, free, learn, easy, customize"
msgstr ""
"KDE, Kdenlive, user interface, widget, layout, arrange, documentation,user  "
"manual, video editor, open source, zadarmo, učiť sa, jednoduché,customize"

