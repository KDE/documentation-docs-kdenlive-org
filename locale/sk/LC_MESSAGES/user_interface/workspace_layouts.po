#: ../../user_interface/workspace_layouts.rst:-1
msgid "Kdenlive's User Interface - Workspace Layout"
msgstr "Používateľské rozhranie Kdenlive - Rozloženie pracovnej plochy"

#: ../../user_interface/workspace_layouts.rst:-1
msgid ""
"KDE, Kdenlive, user interface, documentation, user manual, video editor, "
"open source, free, learn, easy, user interface, layout, workspace"
msgstr ""
"KDE, Kdenlive, používateľské rozhranie, dokumentácia, používateľská "
"príručka, editor videa, open source, slobodný, naučiť sa, jednoduché, "
"rozloženie, pracovná plocha"

#: ../../user_interface/workspace_layouts.rst:27
msgid "Workspace Layouts"
msgstr "Rozloženia pracovnej plochy"

#: ../../user_interface/workspace_layouts.rst:34
msgid ""
"These workspaces aim to improve the layout for each stage of video "
"production:"
msgstr ""
"Tieto pracovné plochy majú za cieľ zlepšiť rozloženie pre každú fázu "
"produkcie videa:"

#: ../../user_interface/workspace_layouts.rst:37
msgid "**Logging** for reviewing your footage"
msgstr "**Záznam** na prezeranie vášho materiálu"

#: ../../user_interface/workspace_layouts.rst:39
msgid ""
"**Editing** to compose your story in the timeline (This layout can :ref:"
"`autoswitch horizontally or vertically <project-settings>` depends of the "
"profile you chose)"
msgstr ""
"**Strih** na zostavenie vášho príbehu na časovej osi (Toto rozloženie sa "
"môže :ref:`automaticky prepnúť horizontálne alebo vertikálne <project-"
"settings>` v závislosti od zvoleného profilu)"

#: ../../user_interface/workspace_layouts.rst:41
msgid "**Audio** for mixing and adjusting your audio"
msgstr "**Zvuk** na mixovanie a úpravu vášho zvuku"

#: ../../user_interface/workspace_layouts.rst:43
msgid "**Effects** for adding effects"
msgstr "**Efekty** na pridávanie efektov"

#: ../../user_interface/workspace_layouts.rst:45
msgid "**Color** for adjusting and color grading"
msgstr "**Farba** na úpravu a farebné ladenie"

#: ../../user_interface/workspace_layouts.rst:48
msgid ""
"Check out this `video <https://www.youtube.com/watch?v=BdHbUUjfBLk>`_ for "
"more details."
msgstr ""
