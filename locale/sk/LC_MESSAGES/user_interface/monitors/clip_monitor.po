#: ../../user_interface/monitors/clip_monitor.rst:181
msgid "Go to Next Snap Point"
msgstr "Prejsť na nasledujúcu zarážku"

#: ../../user_interface/monitors/clip_monitor.rst:182
msgid ":kbd:`Alt+Right`"
msgstr ":kbd:`Alt+Right`"

#: ../../user_interface/monitors/clip_monitor.rst:183
msgid "Moves the :term:`playhead` to the next :term:`snap point`"
msgstr ""
"Presunie :term:`prehrávaciu hlavu<playhead>` na nasledujúci :term:`bod "
