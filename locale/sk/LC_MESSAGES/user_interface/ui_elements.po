#: ../../user_interface/ui_elements.rst:-1
msgid "Kdenlive Documentation - UI Elements, Icons and Buttons"
msgstr "Dokumentácia Kdenlive – UI Elements, Icons and Buttons"

#: ../../user_interface/ui_elements.rst:-1
msgid ""
"KDE, Kdenlive, user interface, documentation, user manual, video editor, "
"open source, free, learn, easy, user interface, ui elements, controls, "
"icons, buttons"
msgstr ""
"KDE, Kdenlive, user interface, documentation, user manual, videoeditor,  "
"open source, zadarmo, učiť sa, jednoduché, user interface, uielements, "
"controls,  icons, buttons"

#: ../../user_interface/ui_elements.rst:0
msgid ""
"Show Safe Areas. Where essentials (text, logos, main action) must stay to "
"avoid being cut off by different screens or platform interfaces. Important "
"for social media and older TVs."
msgstr ""
"Zobraziť bezpečné oblasti. Miesta, kde musia zostať dôležité prvky (text, "
"logá, hlavná akcia), aby neboli odrezané rôznymi obrazovkami alebo "
"rozhraniami platforiem. Dôležité pre sociálne médiá a staršie televízory."

#: ../../user_interface/ui_elements.rst:0
msgid "Title Safe (inner 80%) for text/graphics"
msgstr "Bezpečná oblasť pre titulky (vnútorných 80 %) pre text/grafiku"

#: ../../user_interface/ui_elements.rst:0
msgid "Action Safe (inner 90%) for important visuals"
msgstr "Bezpečná oblasť pre akciu (vnútorných 90 %) pre dôležité vizuály"

#: ../../user_interface/ui_elements.rst:16
msgid "UI Elements"
msgstr "Prvky používateľského rozhrania"

