#: ../../user_interface/menu/settings_menu/full_screen_mode.rst:13
msgid "Full Screen Mode"
msgstr "Režim celej obrazovky"

#: ../../user_interface/menu/settings_menu/full_screen_mode.rst:16
msgid ""
"Selecting this causes **Kdenlive** to fill the entire screen. Select this "
"menu item again to undo full screen mode."
msgstr ""
"Výberom tejto položky sa **Kdenlive** zobrazí na celej obrazovke. Opätovným "
"výberom tejto položky ponuky zrušíte režim celej obrazovky."

