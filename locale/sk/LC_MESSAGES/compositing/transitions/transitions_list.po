msgstr "Zvislé stieranie dvere stodoly (|frei0r.sleid0r_wipe-barn-door-v|)"

#: ../../compositing/transitions/transitions_list.rst:80
msgid ".._wipe-down-up:"
msgstr ".._wipe-down-up:"

