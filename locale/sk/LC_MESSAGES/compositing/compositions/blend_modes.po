#: ../../compositing/compositions/blend_modes.rst:-1
msgid "Kdenlive Documentation - Compositing: Composition Blend Modes"
msgstr "Dokumentácia Kdenlive – Compositing: Composition Blend Modes"

#: ../../compositing/compositions/blend_modes.rst:-1
msgid ""
"KDE, Kdenlive, documentation, user manual, video editor, open source, free, "
"learn, easy, compositing, composition, compositions, blend, modes"
msgstr ""
"KDE, Kdenlive, documentation, user manual, video editor, open source,free,  "
"learn, easy, compositing, composition, compositions, blend,modes"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "Addition /"
msgstr "Sčítanie /"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "addition_alpha"
msgstr "addition_alpha"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "Add"
msgstr "Pridať"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] addition or addition_alpha operation of the pixel sources "
"(|frei0r.addition| and |frei0r.addition_alpha|, respectively)"
msgstr ""
"Vykonanie RGB[A] operácie sčítania alebo addition_alpha pixelových zdrojov (|"
"frei0r.addition| a |frei0r.addition_alpha|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "Color Burn"
msgstr "Prepálenie farby"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] dodge operation between the pixel sources\\ [1]_ (|frei0r."
"burn|)"
msgstr ""
"Vykonanie RGB[A] operácie dodge medzi pixelovými zdrojmi\\ [1]_ (|frei0r."
"burn|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "No equivalent"
msgstr "Žiadny ekvivalent"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform a conversion to color only of the source input 1 using the hue and "
"saturation values of input 2 (|frei0r.color_only|)"
msgstr ""
"Vykonanie konverzie iba na farbu zdrojového vstupu 1 pomocou hodnôt odtieňa "
"a sýtosti vstupu 2 (|frei0r.color_only|)"

#: ../../compositing/compositions/blend_modes.rst:0
#: ../../compositing/compositions/blend_modes.rst:64
msgid "Darken"
msgstr "Zatemniť"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform a darken operation between two sources (minimum value for both "
"sources) (|frei0r.darken|)"
msgstr ""
"Vykonanie operácie stmavenia medzi dvoma zdrojmi (minimálna hodnota pre oba "
"zdroje) (|frei0r.darken|)"

#: ../../compositing/compositions/blend_modes.rst:0
#: ../../compositing/compositions/blend_modes.rst:70
msgid "Difference"
msgstr "Rozdiel"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] difference operation between the pixel sources. (|frei0r."
"difference|)"
msgstr ""
"Vykonanie RGB[A] operácie rozdielu medzi pixelovými zdrojmi. (|frei0r."
"difference|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] divide operation between the pixel sources\\ [2]_ (|frei0r."
"divide|)"
msgstr ""
"Vykonanie RGB[A] operácie delenia medzi pixelovými zdrojmi\\ [2]_ (|frei0r."
"divide|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "Color Dodge"
msgstr "Farebný úskok"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] dodge operation between the pixel sources\\ [3]_ (|frei0r."
"dodge|)"
msgstr ""
"Vykonanie RGB[A] operácie dodge medzi pixelovými zdrojmi\\ [3]_ (|frei0r."
"dodge|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] grain-extract operation between the pixel sources (|frei0r."
"grain_extract|)"
msgstr ""
"Vykonanie RGB[A] operácie grain-extract medzi pixelovými zdrojmi (|frei0r."
"grain_extract|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] grain-merge operation between the pixel sources (|frei0r."
"grain_merge|)"
msgstr ""
"Vykonanie RGB[A] operácie grain-merge medzi pixelovými zdrojmi (|frei0r."
"grain_merge|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "Hard light"
msgstr "Tvrdé svetlo"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] hardlight operation between the pixel sources (|frei0r."
"hardlight|)"
msgstr ""
"Vykonanie RGB[A] operácie hardlight medzi pixelovými zdrojmi (|frei0r."
"hardlight|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "HSL hue"
msgstr "HSL odtieň"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform a conversion to hue only of the source input1 using the hue of "
"input2 (|frei0r.hue|)"
msgstr ""
"Vykonanie konverzie iba na odtieň zdrojového vstupu1 pomocou odtieňa vstupu2 "
"(|frei0r.hue|)"

#: ../../compositing/compositions/blend_modes.rst:0
#: ../../compositing/compositions/blend_modes.rst:112
msgid "Lighten"
msgstr "Zosvetliť"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform a lighten operation between two sources (maximum value of both "
"sources) (|frei0r.lighten|)"
msgstr ""
"Vykonanie operácie zosvetlenia medzi dvoma zdrojmi (maximálna hodnota oboch "
"zdrojov) (|frei0r.lighten|)"

#: ../../compositing/compositions/blend_modes.rst:0
#: ../../compositing/compositions/blend_modes.rst:118
msgid "Multiply"
msgstr "Násobenie"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] multiply operation between the pixel sources (|frei0r."
"multiply|)"
msgstr ""
"Vykonanie RGB[A] operácie násobenia medzi pixelovými zdrojmi (|frei0r."
"multiply|)"

#: ../../compositing/compositions/blend_modes.rst:0
#: ../../compositing/compositions/blend_modes.rst:124
msgid "Overlay"
msgstr "Prekladanie"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] overlay operation between the pixel sources\\ [4]_ (|"
"frei0r.overlay|)"
msgstr ""
"Vykonanie RGB[A] operácie prekrytia medzi pixelovými zdrojmi\\ [4]_ (|frei0r."
"overlay|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "HSL saturation"
msgstr "HSL sýtosť"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform a conversion to saturation only of the source input1 using the "
"saturation level of input2 (|frei0r.saturation|)"
msgstr ""
"Vykonanie konverzie iba na sýtosť zdrojového vstupu1 pomocou úrovne sýtosti "
"vstupu2 (|frei0r.saturation|)"

#: ../../compositing/compositions/blend_modes.rst:0
#: ../../compositing/compositions/blend_modes.rst:136
msgid "Screen"
msgstr "Obrazovka"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] screen operation between the pixel sources\\ [5]_ "
"effectively using black as the alpha channel (|frei0r.screen|)"
msgstr ""
"Vykonanie RGB[A] operácie screen medzi pixelovými zdrojmi\\ [5]_ efektívne "
"používajúc čiernu ako alfa kanál (|frei0r.screen|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid "Soft light"
msgstr "Mäkké svetlo"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] softlight operation between the pixel sources (|frei0r."
"softlight|)"
msgstr ""
"Vykonanie RGB[A] operácie softlight medzi pixelovými zdrojmi (|frei0r."
"softlight|)"

#: ../../compositing/compositions/blend_modes.rst:0
msgid ""
"Perform an RGB[A] subtract operation of the pixel source input2 from input1 "
"(|frei0r.subtract|)"
msgstr ""
"Vykonanie RGB[A] operácie odčítania pixelového zdroja input2 od input1 (|"
"frei0r.subtract|)"

#: ../../compositing/compositions/blend_modes.rst:15
msgid "Composition Blend Modes"
msgstr "Režimy miešania kompozície"

#: ../../compositing/compositions/blend_modes.rst:17
msgid ""
"For Kdenlive, some composition types are basically :doc:`blending modes </"
"compositing/blending_modes>` (see there for a detailed description)."
msgstr ""
"Pre Kdenlive sú niektoré typy kompozícií v podstate :doc:`režimy miešania </"
"compositing/blending_modes>` (pozri tam pre podrobný popis)."

#: ../../compositing/compositions/blend_modes.rst:26
msgid "Changing the composition **Blend Mode**"
msgstr "Zmena **režimu miešania** kompozície"

#: ../../compositing/compositions/blend_modes.rst:28
msgid ""
"You can change the **Blend Mode** by selecting from the :guilabel:"
"`Composition Type` drop-down list."
msgstr ""
"Môžete zmeniť **režim miešania** výberom z rozbaľovacieho zoznamu :guilabel:"
"`Composition Type`."

#: ../../compositing/compositions/blend_modes.rst:32
msgid ""
"The following table below lists the composition types and their blending "
"mode counterpart in :guilabel:`Composition Type` **Cairo Blend**:"
msgstr ""
"Nasledujúca tabuľka uvádza typy kompozícií a ich zodpovedajúce režimy "
"miešania v :guilabel:`Composition Type` **Cairo Blend**:"

#: ../../compositing/compositions/blend_modes.rst:40
msgid "Composition Type"
msgstr "Typ kompozície"

#: ../../compositing/compositions/blend_modes.rst:41
msgid "Example"
msgstr "Príklad"

#: ../../compositing/compositions/blend_modes.rst:42
msgid "Blending Mode"
msgstr "Režim miešania"

#: ../../compositing/compositions/blend_modes.rst:52
msgid "Burn"
msgstr "Napáliť"

#: ../../compositing/compositions/blend_modes.rst:58
msgid "Color Only"
msgstr "Farebný kľúč"

#: ../../compositing/compositions/blend_modes.rst:76
msgid "Divide"
msgstr "Deliť"

#: ../../compositing/compositions/blend_modes.rst:82
msgid "Dodge"
msgstr "Zesvietlenie"

#: ../../compositing/compositions/blend_modes.rst:88
msgid "Grain Extract"
msgstr "Rozbalenie zŕn"

#: ../../compositing/compositions/blend_modes.rst:94
msgid "Grain Merge"
msgstr "Zlúčenie zŕn"

#: ../../compositing/compositions/blend_modes.rst:100
msgid "Hardlight"
msgstr "Výška"

#: ../../compositing/compositions/blend_modes.rst:106
msgid "Hue"
msgstr "Odtieň"

#: ../../compositing/compositions/blend_modes.rst:130
msgid "Saturation"
msgstr "Nasýtenie"

#: ../../compositing/compositions/blend_modes.rst:142
msgid "Softlight"
msgstr "Vľavo,Vpravo"

#: ../../compositing/compositions/blend_modes.rst:148
msgid "Subtract"
msgstr "Rozdiel"

#: ../../compositing/compositions/blend_modes.rst:156
msgid ""
"It uses the generalized algorithm: :code:`D = saturation of 255 or depletion "
"of 0, of ((255-A)*256) / (b+1)`"
msgstr ""
"Používa zovšeobecnený algoritmus: :code:`D = saturation of 255 or depletion "
"of 0, of ((255-A)*256) / (b+1)`"

#: ../../compositing/compositions/blend_modes.rst:158
msgid "Input 1 is the numerator, input 2 the denominator"
msgstr "Vstup 1 je čitateľ, vstup 2 menovateľ"

#: ../../compositing/compositions/blend_modes.rst:160
msgid ""
"It uses the generalized algorithm: :code:`D = saturation of 255 or (A*256)/"
"(256-B)`"
msgstr ""
"Používa zovšeobecnený algoritmus: :code:`D = saturation of 255 or (A*256)/"
"(256-B)`"

#: ../../compositing/compositions/blend_modes.rst:162
msgid ""
"It uses using the generalized algorithm: :code:`D = A * (B + (2 * B) * (255 "
"- A))`"
msgstr ""
"Používa zovšeobecnený algoritmus: :code:`D = A * (B + (2 * B) * (255 - A))`"

#: ../../compositing/compositions/blend_modes.rst:164
msgid ""
"It uses using the generalized algorithm: :code:`D = 255 - (255 - A) * (255 - "
"B)`"
msgstr ""
"Používa zovšeobecnený algoritmus: :code:`D = 255 - (255 - A) * (255 - B)`"
