msgid "Parameter"
msgstr "Параметр"

#: ../../effects_and_filters/video_effects/blur_and_sharpen/planes_blur.rst:54
msgid "Value"
msgstr "Значение"

#: ../../effects_and_filters/video_effects/blur_and_sharpen/planes_blur.rst:59
