#: ../../effects_and_filters/video_effects/transform_distort_perspective/position_and_zoom.rst:66
#: ../../effects_and_filters/video_effects/transform_distort_perspective/position_and_zoom.rst:69
msgid "Switch"
msgstr "Переключатель"

#: ../../effects_and_filters/video_effects/transform_distort_perspective/position_and_zoom.rst:67
msgid ""
"Determines whether the image aspect ratio will be distorted while scaling to "
"completely fill the rectangle"
msgstr ""
"Определяет, будет ли искажено соотношение сторон изображения при "
"масштабировании для полного заполнения прямоугольника"

#: ../../effects_and_filters/video_effects/transform_distort_perspective/position_and_zoom.rst:68
msgid "Normalise"
msgstr "Нормализация"

#: ../../effects_and_filters/video_effects/transform_distort_perspective/position_and_zoom.rst:70
msgid "Use the video resolution instead of the project resolution"
msgstr "Использовать разрешение видео вместо разрешения проекта"

#: ../../effects_and_filters/video_effects/transform_distort_perspective/position_and_zoom.rst:71
msgid "X / Y / W / H / Size"
msgstr "X / Y / Ш / В / Размер"

#: ../../effects_and_filters/video_effects/transform_distort_perspective/position_and_zoom.rst:72
