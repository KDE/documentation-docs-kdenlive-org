#: ../../effects_and_filters/video_effects/stylize/ndvi_filter.rst:63
#: ../../effects_and_filters/video_effects/stylize/ndvi_filter.rst:66
#: ../../effects_and_filters/video_effects/stylize/ndvi_filter.rst:69
#: ../../effects_and_filters/video_effects/stylize/ndvi_filter.rst:72
