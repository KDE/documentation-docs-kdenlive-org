#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_operations.rst:112
msgid ":guilabel:`Operation`"
msgstr ":guilabel:`Операция`"

#: ../../effects_and_filters/video_effects/alpha_mask_keying/alpha_operations.rst:118
