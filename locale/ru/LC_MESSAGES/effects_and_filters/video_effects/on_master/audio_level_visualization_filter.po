#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:68
msgid "Mirror"
msgstr "Зеркальное отражение"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:69
#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:72
msgid "Switch"
msgstr "Переключатель"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:70
msgid "If checked, mirrors the spectrum on the center line of the rectangle"
msgstr ""
"Если флажок установлен, спектр зеркально отражается относительно центральной "
"линии прямоугольника"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:71
msgid "Reverse"
msgstr "Реверс"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:73
msgid "If checked, draws the points starting with the right channel"
msgstr "Если флажок установлен, точки рисуются начиная с правого канала"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:74
msgid "Gradient Orientation"
msgstr "Ориентация градиента"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:76
msgid "Sets the direction of the color gradient"
msgstr "Задаёт направление цветового градиента"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:77
msgid "Background Color"
msgstr "Цвет фона"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:78
#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:81
msgid "Picker"
msgstr "Выбор цвета"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:79
msgid "Defines the background color to be applied to the entire frame"
msgstr "Задаёт цвет фона, применяемый ко всему кадру"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:80
msgid "Gradient Color 1 / 2 / 3"
msgstr "Цвет градиента 1 / 2 / 3"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:82
msgid ""
"Defines color of the waveform gradient. Color 1 defines the top, 2 the "
"middle and 3 the bottom of the gradient"
msgstr ""
"Задаёт цвет градиента формы сигнала. Цвет 1 задаёт верх, 2 — середину, 3 — "
"низ градиента"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:83
msgid "Line Thickness"
msgstr "Толщина линии"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:84
#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:87
#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:93
#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:96
msgid "Integer"
msgstr "Целое"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:85
msgid "Defines the thickness of the bar or segments in number of pixels"
msgstr "Задаёт толщину полосы или сегментов в пикселях"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:86
msgid "Angle"
msgstr "Угол"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:88
msgid "Defines the rotation angle to be applied to the waveform"
msgstr "Задаёт угол поворота, применяемый к форме сигнала"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:89
msgid "X / Y / W / H / Size / Opacity"
msgstr "X / Y / W / H / Размер / Непрозрачность"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:91
msgid ""
"Defines the X and Y coordinates, Width and Height, Size and Opacity of the "
"rectangle in which the waveform is drawn. The icons help lining up the "
"rectangle."
msgstr ""
"Задаёт координаты X и Y, ширину и высоту, размер и непрозрачность "
"прямоугольника, в котором рисуется форма сигнала. Значки помогают выровнять "
"прямоугольник."

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:92
msgid "Channels"
msgstr "Каналы"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:94
msgid "Defines the number of channels to show"
msgstr "Задаёт число каналов для показа"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:95
msgid "Segment Gap"
msgstr "Промежуток между сегментами"

#: ../../effects_and_filters/video_effects/on_master/audio_level_visualization_filter.rst:97
msgid "Defines the space in pixels between segments"
msgstr "Задаёт расстояние между сегментами в пикселях"

