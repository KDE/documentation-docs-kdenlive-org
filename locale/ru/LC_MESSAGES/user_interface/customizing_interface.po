#: ../../user_interface/customizing_interface.rst:-1
msgid ""
"KDE, Kdenlive, user interface, widget, layout, arrange, documentation, user "
"manual, video editor, open source, free, learn, easy, customize"
msgstr ""
"KDE, Kdenlive, пользовательский интерфейс, виджет, макет, упорядочивание, "
"документация, руководство пользователя, видеоредактор, открытый исходный "
"код, свободное ПО, изучение, простота, настройка"

