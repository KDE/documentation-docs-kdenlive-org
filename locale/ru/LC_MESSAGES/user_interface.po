msgstr "Знакомство с пользовательским интерфейсом Kdenlive"

#: ../../user_interface.rst:-1
msgid ""
"KDE, Kdenlive, user interface, documentation, user manual, video editor, "
"open source, free, learn, easy, user interface, layout, widget"
msgstr ""
"KDE, Kdenlive, пользовательский интерфейс, документация, руководство "
"пользователя, видеоредактор, открытый исходный код, свободное ПО, обучение, "
"простота, пользовательский интерфейс, макет, виджет"

