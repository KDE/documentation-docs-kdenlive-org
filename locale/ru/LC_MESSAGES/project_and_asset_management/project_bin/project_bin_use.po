msgid "Kdenlive Documentation - Using the Project Bin"
msgstr "Документация Kdenlive — Использование корзины проекта"

#: ../../project_and_asset_management/project_bin/project_bin_use.rst:-1
#: ../../project_and_asset_management/project_bin/project_bin_use_context_menu.rst:-1
