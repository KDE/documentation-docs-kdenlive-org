#: ../../project_and_asset_management/project_bin/clip_properties.rst:127
msgid ":guilabel:`Normalize`:"
msgstr ":guilabel:`Нормализовать`:"

#: ../../project_and_asset_management/project_bin/clip_properties.rst:127
