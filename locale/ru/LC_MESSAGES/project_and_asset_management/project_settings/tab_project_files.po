#: ../../project_and_asset_management/project_settings/tab_project_files.rst:22
msgid "Project Files"
msgstr "Файлы проекта"

#: ../../project_and_asset_management/project_settings/tab_project_files.rst:24
msgid "The Project Files tab shows all the external assets for this project:"
msgstr "Вкладка «Файлы проекта» показывает все внешние ресурсы этого проекта:"

#: ../../project_and_asset_management/project_settings/tab_project_files.rst:26
msgid "Video clips"
msgstr "Видеоклипы"

#: ../../project_and_asset_management/project_settings/tab_project_files.rst:27
