msgid "Parameters"
msgstr "Parameters"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:56
msgid "Parameter"
msgstr "Parameter"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:57
msgid "Value"
msgstr "Waarde"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:59
msgid "Amplitude X"
msgstr "Amplitude X"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:60
#: ../../effects_and_filters/video_effects/motion/camerashake.rst:63
#: ../../effects_and_filters/video_effects/motion/camerashake.rst:78
msgid "Integer"
msgstr "Geheel getal"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:61
msgid "Maximum horizontal shake amplitude. Maximum amplitude is 500 pixels."
msgstr "Maximum horizontale schud amplitude. Maximum amplitude is 500 pixels."

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:62
msgid "Amplitude Y"
msgstr "Amplitude Y"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:64
msgid "Maximum vertical shake amplitude. Maximum amplitude is 500 pixels."
msgstr "Maximum verticale schud amplitude. Maximum amplitude is 500 pixels."

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:65
msgid "Rotation"
msgstr "Rotation"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:66
#: ../../effects_and_filters/video_effects/motion/camerashake.rst:72
msgid "Float"
msgstr "Drijvende komma"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:67
msgid "Maximum rotation shake (capped at 45 degrees either direction)"
msgstr "Maximum schudrotatie (begrenst op 45 graden in beide richtingen)"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:68
msgid "Zoom"
msgstr "Zoomen"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:69
#: ../../effects_and_filters/video_effects/motion/camerashake.rst:75
msgid "Percent"
msgstr "Percent"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:70
msgid ""
"Zoom factor to hide black borders. This is in addition to 100%. For example: "
"0% means not additional zoom; 100% means image is twice as large (total of "
"200% of original size)."
msgstr ""
"Zoom factor om zwarte randen te verbergen. Dit moet bij 100% opgeteld "
"worden. Bijvoorbeeld: 0% houdt in geen extra zoom; 100% houdt in dat de "
"afbeelding twee keer zo groot wordt (totaal van 200% van originele afmeting)."

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:71
msgid "Shake intensity"
msgstr "Shake intensity"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:73
msgid ""
"Speed or frequency of the shake. This is not linear and values towards "
"either end of the scale decrease the intensity. Maximum intensity is "
"somewhere in the middle."
msgstr ""
"Snelheid of frequentie van het schudden. Dit is niet lineair en de waarden "
"bij de einden van de schaal verminderen in intensiteit. De maximum "
"intensiteit is ergens in het midden."

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:74
msgid "Opacity"
msgstr "Opacity"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:76
msgid ""
"Opacity of the effect. 0% means fully transparent, 100% means fully opaque."
msgstr ""
"De transparantie van het effect. 0% betekent volledig transparant, 100% "
"betekent volledig dekkend."

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:77
msgid "Motion blur"
msgstr "Motion blur"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:79
msgid ""
"Amount of motion blur measured in radius in pixels. Capped at 20 pixels."
msgstr ""
"De hoeveelheid motion blur gemeten met een radius gemeten in pixels. "
"Begrenst op 20 pixels."

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:80
msgid "Color"
msgstr "Color"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:81
msgid "Selection"
msgstr "Selectie"

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:82
msgid ""
"Background color for exposed borders. Alpha channel is **not** supported."
msgstr ""
"Achtergrondkleur voor zichtbare randen. Alfakanaal wordt **niet** "
"ondersteund."

#: ../../effects_and_filters/video_effects/motion/camerashake.rst:86
msgid "Using motion blur slows down the shake effect significantly."
msgstr "Let op: het gebruik van motion blur vertraagt het schud-effect erg."
